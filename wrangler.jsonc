{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rakhuno",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "102794b6995d415c78ed2978c4e7b241",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "rakhuno.com",
      "custom_domain": true
    },
    {
      "pattern": "www.rakhuno.com",
      "custom_domain": true
    },
    {
      "pattern": "app.rakhuno.com",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "LEADS",
      "id": "07624bb9d3664a0ab3131478728ff85b"
    }
  ]
}
