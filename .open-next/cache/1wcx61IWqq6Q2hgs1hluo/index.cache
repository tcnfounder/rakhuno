pt><script src=\"/_next/static/chunks/turbopack-3mtwpzaowkout.js\" async=\"\"></script><script src=\"/_next/static/chunks/3fntmmi971322.js\" async=\"\"></script><script src=\"/_next/static/chunks/38k2_7amoczom.js\" async=\"\"></script><title>Rakhuno — простий рахунок для ФОП</title><meta name=\"description\" content=\"Створіть рахунок-фактуру за 2 хвилини. Email-нагадування про податки для ФОП. Без складної бухгалтерії.\"/><link rel=\"canonical\" href=\"https://rakhuno.com\"/><meta property=\"og:title\" content=\"Rakhuno — простий рахунок для ФОП\"/><meta property=\"og:description\" content=\"Створіть рахунок-фактуру за 2 хвилини. Email-нагадування про податки.\"/><meta property=\"og:url\" content=\"https://rakhuno.com\"/><meta property=\"og:site_name\" content=\"Rakhuno\"/><meta property=\"og:locale\" content=\"uk_UA\"/><meta property=\"og:image\" content=\"https://rakhuno.com/brand/hero.jpg\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"800\"/><meta property=\"og:image:alt\" content=\"Rakhuno\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Rakhuno — простий рахунок для ФОП\"/><meta name=\"twitter:description\" content=\"Створіть рахунок-фактуру за 2 хвилини. Email-нагадування про податки.\"/><meta name=\"twitter:image\" content=\"https://rakhuno.com/brand/hero.jpg\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"unbounded_79852592-module__iL15sq__variable onest_474d6921-module__x_1SKq__variable antialiased\"><div hidden=\"\"><!--$--><!--/$--></div><main class=\"min-h-screen bg-ink text-paper\"><section class=\"relative min-h-[100svh] overflow-hidden\"><img alt=\"\" decoding=\"async\" data-nimg=\"fill\" class=\"img-pan object-cover object-center\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fbrand%2Fhero.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fbrand%2Fhero.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fbrand%2Fhero.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fbrand%2Fhero.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fbrand%2Fhero.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fbrand%2Fhero.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fbrand%2Fhero.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fbrand%2Fhero.webp&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fbrand%2Fhero.webp&amp;w=3840&amp;q=75\"/><div class=\"absolute inset-0 bg-gradient-to-t from-ink via-ink/80 to-ink/30\"></div><div class=\"absolute inset-0 bg-[radial-gradient(ellipse_at_75%_15%,rgba(198,242,109,0.16),transparent_50%)]\"></div><div class=\"relative z-10 flex min-h-[100svh] flex-col\"><header class=\"relative z-20 flex items-center justify-between px-5 py-5 md:px-10\"><a class=\"font-display text-xl font-semibold tracking-tight text-paper md:text-2xl\" href=\"/\">Rakhuno</a><nav class=\"flex items-center gap-3 text-sm md:gap-5\"><a class=\"hidden text-mist transition hover:text-paper sm:inline\" href=\"/guides\">Гіди</a><a class=\"hidden text-mist transition hover:text-paper md:inline\" href=\"/#yak-pratsyuye\">Як працює</a><a class=\"rounded-full bg-signal px-4 py-2 font-medium text-ink transition hover:bg-white\" href=\"/invoice\">Безкоштовний рахунок</a></nav></header><div class=\"flex flex-1 flex-col justify-end px-5 pb-16 pt-10 md:px-10 md:pb-24\"><div class=\"mx-auto w-full max-w-content\"><p class=\"rise font-display text-5xl font-semibold tracking-tight sm:text-7xl md:text-8xl lg:text-9xl\">Rakhuno</p><h1 class=\"rise rise-delay-1 mt-6 max-w-3xl font-display text-2xl font-medium leading-tight sm:text-4xl md:text-5xl\">Простий рахунок для ФОП</h1><p class=\"rise rise-delay-2 mt-5 max-w-xl text-base leading-relaxed text-paper/85 sm:text-lg\">Рахунок-фактура за 2 хвилини. Нагадування про єдиний податок у email. Без важкої бухгалтерії.</p><div class=\"rise rise-delay-3 mt-8 flex flex-wrap items-center gap-3\"><a class=\"inline-flex items-center rounded-full bg-signal px-6 py-3 text-base font-semibold text-ink transition hover:bg-white\" href=\"/invoice\">Створити рахунок безкоштовно</a><a href=\"#yak-pratsyuye\" class=\"inline-flex items-center rounded-full border border-white/25 px-6 py-3 text-base text-paper transition hover:border-signal hover:text-signal\">Як це працює</a></div></div></div></div></section><section id=\"yak-pratsyuye\" class=\"border-t border-line\"><div class=\"mx-auto grid max-w-content lg:grid-cols-2\"><div class=\"flex flex-col justify-center px-5 py-16 md:px-10 md:py-24\"><p class=\"font-display text-sm uppercase tracking-[0.18em] text-signal\">Процес</p><h2 class=\"mt-3 font-display text-3xl font-semibold md:text-5xl\">Один інструмент. Дві справи.</h2><p class=\"mt-4 max-w-xl text-mist\">Виставляєте рахунок клієнту. Ми нагадуємо, коли платити податки. Все інше — пізніше.</p><ol class=\"mt-10 space-y-8\"><li class=\"border-t border-line pt-5\"><p class=\"font-display text-sm text-signal\">01</p><h3 class=\"mt-2 font-display text-xl\">Заповніть реквізити</h3><p class=\"mt-2 text-sm leading-relaxed text-mist\">ФОП, ІПН, IBAN, послуги — звичні поля українською.</p></li><li class=\"border-t border-line pt-5\"><p class=\"font-display text-sm text-signal\">02</p><h3 class=\"mt-2 font-display text-xl\">Залиште email</h3><p class=\"mt-2 text-sm leading-relaxed text-mist\">Отримаєте PDF і календар нагадувань для вашої групи ФОП.</p></li><li class=\"border-t border-line pt-5\"><p class=\"font-display text-sm text-signal\">03</p><h3 class=\"mt-2 font-display text-xl\">Не пропустіть податки</h3><p class=\"mt-2 text-sm leading-relaxed text-mist\">Лист за 3 дні до строку. Pro відкриє автоматичні нагадування.</p></li></ol></div><div class=\"relative min-h-[320px] overflow-hidden bg-ink-2 lg:min-h-full\"><img alt=\"Рахунок на столі — атмосфера Rakhuno\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 1024px) 100vw, 50vw\" srcSet=\"/_next/image?url=%2Fbrand%2Finvoice.webp&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fbrand%2Finvoice.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fbrand%2Finvoice.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fbrand%2Finvoice.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fbrand%2Finvoice.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fbrand%2Finvoice.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fbrand%2Finvoice.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fbrand%2Finvoice.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fbrand%2Finvoice.webp&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fbrand%2Finvoice.webp&amp;w=3840&amp;q=75\"/><div class=\"absolute inset-0 bg-gradient-to-r from-ink/50 via-transparent to-transparent lg:from-ink/30\"></div></div></div></section><section id=\"podatky\" class=\"border-t border-line bg-ink-2\"><div class=\"mx-auto grid max-w-content lg:grid-cols-2\"><div class=\"relative order-2 min-h-[320px] overflow-hidden lg:order-1 lg:min-h-full\"><img alt=\"Нагадування про податки в email\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 1024px) 100vw, 50vw\" srcSet=\"/_next/image?url=%2Fbrand%2Freminder.webp&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fbrand%2Freminder.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fbrand%2Freminder.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fbrand%2Freminder.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fbrand%2Freminder.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fbrand%2Freminder.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fbrand%2Freminder.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fbrand%2Freminder.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fbrand%2Freminder.webp&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fbrand%2Freminder.webp&amp;w=3840&amp;q=75\"/><div class=\"absolute inset-0 bg-gradient-to-l from-ink-2/60 via-transparent to-transparent lg:from-ink-2/40\"></div></div><div class=\"order-1 flex flex-col justify-center px-5 py-16 md:px-10 md:py-24 lg:order-2\"><p class=\"font-display text-sm uppercase tracking-[0.18em] text-signal\">Email</p><h2 class=\"mt-3 font-display text-3xl font-semibold md:text-5xl\">Нагадування, не консультація</h2><p class=\"mt-4 max-w-xl text-mist\">Rakhuno не замінює бухгалтера. Ми лише нагадуємо типові строки для ФОП 2–3 групи — щоб ви не забули відкрити календар.</p><ul class=\"mt-10 space-y-4\"><li class=\"flex gap-3 border-b border-line pb-4\"><span class=\"text-signal\">→</span><span>Єдиний податок — типове вікно сплати</span></li><li class=\"flex gap-3 border-b border-line pb-4\"><span class=\"text-signal\">→</span><span>ЄСВ — щомісячні / квартальні нагадування</span></li><li class=\"flex gap-3 pb-4\"><span class=\"text-signal\">→</span><span>Декларація — сезонні листи</span></li></ul><a class=\"mt-8 inline-flex w-fit rounded-full bg-signal px-6 py-3 font-semibold text-ink transition hover:bg-white\" href=\"/invoice\">Почати з рахунку</a></div></div></section><section class=\"border-t border-line px-5 py-16 md:px-10\"><div class=\"mx-auto flex max-w-content flex-col items-start justify-between gap-6 md:flex-row md:items-center\"><div><h2 class=\"font-display text-2xl font-semibold md:text-3xl\">Готові виставити рахунок?</h2><p class=\"mt-2 text-mist\">Безкоштовно. PDF одразу. Email — для нагадувань.</p></div><a class=\"inline-flex rounded-full bg-signal px-6 py-3 font-semibold text-ink transition hover:bg-white\" href=\"/invoice\">Відкрити Rakhuno</a></div></section><footer class=\"border-t border-line px-5 py-10 text-sm text-muted md:px-10\"><div class=\"mx-auto flex max-w-content flex-col gap-3 sm:flex-row sm:items-center sm:justify-between\"><p>© <!-- -->2026<!-- --> Rakhuno</p><div class=\"flex flex-wrap gap-4\"><a class=\"hover:text-signal\" href=\"/guides\">Гіди</a><a class=\"hover:text-signal\" href=\"/invoice\">Рахунок</a></div><p class=\"max-w-lg\">Не є податковою консультацією. Строки загальні; перевіряйте актуальні вимоги ДПС.</p></div></footer></main><!--$--><!--/$--><script src=\"/_next/static/chunks/3s6nzrbk-8mnv.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[39756,[\\\"/_next/static/chunks/3fntmmi971322.js\\\"],\\\"default\\\"]\\n3:I[37457,[\\\"/_next/static/chunks/3fntmmi971322.js\\\"],\\\"default\\\"]\\n4:I[5500,[\\\"/_next/static/chunks/3fntmmi971322.js\\\",\\\"/_next/static/chunks/38k2_7amoczom.js\\\"],\\\"Image\\\"]\\n5:I[22016,[\\\"/_next/static/chunks/3fntmmi971322.js\\\",\\\"/_next/static/chunks/38k2_7amoczom.js\\\"],\\\"\\\"]\\ne:I[68027,[\\\"/_next/static/chunks/3fntmmi971322.js\\\"],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/2zsy6d7keycfq.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/media/16d91c780434f2ce-s.p.0y1w0k24nk0rl.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/4e1c87b7aa9e2f2f-s.p.3o02-8iknf6dl.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/8800dfc60902df36-s.p.2sla2yow9-9p_.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/b59689b1142d37ce-s.p.1bk8_xp319hr4.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n0:{\\\"P\\\":null,\\\"c\\\":[\\\"\\\",\\\"\\\"],\\\"q\\\":\\\"\\\",\\\"i\\\":false,\\\"f\\